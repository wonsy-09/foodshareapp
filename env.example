import React, { useState } from 'react';
import { X, HeartHandshake, ArrowRightLeft, Sparkles, Image as ImageIcon, Refrigerator } from 'lucide-react';
import { CategoryType, Ingredient, SharingPost, StorageType } from '../types';

interface CreatePostModalProps {
  isOpen: boolean;
  onClose: () => void;
  userIngredients: Ingredient[];
  prefilledIngredient?: Ingredient | null;
  onAddPost: (post: Omit<SharingPost, 'id' | 'createdAt' | 'author' | 'likes'>) => void;
  userLocation: string;
}

export const CreatePostModal: React.FC<CreatePostModalProps> = ({
  isOpen,
  onClose,
  userIngredients,
  prefilledIngredient,
  onAddPost,
  userLocation,
}) => {
  const [selectedFridgeItemId, setSelectedFridgeItemId] = useState<string>(
    prefilledIngredient?.id || ''
  );
  const [title, setTitle] = useState(
    prefilledIngredient ? `${prefilledIngredient.name} 나눔합니다!` : ''
  );
  const [ingredientName, setIngredientName] = useState(
    prefilledIngredient?.name || ''
  );
  const [category, setCategory] = useState<CategoryType>(
    prefilledIngredient?.category || '채소/과일'
  );
  const [quantity, setQuantity] = useState(prefilledIngredient?.quantity || '');
  const [storage, setStorage] = useState<StorageType>(
    prefilledIngredient?.storage || '냉장'
  );
  const [type, setType] = useState<'free' | 'exchange'>('free');
  const [exchangeWant, setExchangeWant] = useState('');
  const [description, setDescription] = useState('');
  const [imageUrl, setImageUrl] = useState(
    'https://images.unsplash.com/photo-1618160702438-9b02ab6515c9?auto=format&fit=crop&w=600&q=80'
  );

  if (!isOpen) return null;

  const handleSelectFridgeItem = (id: string) => {
    setSelectedFridgeItemId(id);
    const item = userIngredients.find((i) => i.id === id);
    if (item) {
      setIngredientName(item.name);
      setCategory(item.category);
      setQuantity(item.quantity);
      setStorage(item.storage);
      setTitle(`${item.name} 이웃 나눔해요 🥬`);
      setDescription(`내 냉장고에 보관 중인 ${item.name}입니다! 소비기한 전 신선할 때 이웃과 나눕니다.`);
    }
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!title.trim() || !ingredientName.trim()) return;

    onAddPost({
      title: title.trim(),
      ingredientName: ingredientName.trim(),
      category,
      quantity: quantity.trim() || '1팩',
      storage,
      expiryDate: new Date(Date.now() + 7 * 86400000).toISOString().split('T')[0],
      location: userLocation,
      distanceKm: 0.3,
      type,
      exchangeWant: type === 'exchange' ? exchangeWant : undefined,
      status: 'available',
      imageUrl,
      description: description.trim() || '1인 가구 자취생 이웃 나눔 식재료입니다.',
    });

    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 bg-[#3A3A2E]/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto">
      <div className="bg-[#FAF9F6] rounded-3xl max-w-lg w-full p-6 shadow-2xl my-8 border border-[rgba(90,90,64,0.15)]">
        <div className="flex items-center justify-between pb-3 border-b border-[rgba(90,90,64,0.1)]">
          <div className="flex items-center gap-2">
            <div className="p-2 bg-[#E9EED9] text-[#5A5A40] rounded-2xl">
              <HeartHandshake className="w-5 h-5 text-[#5A5A40]" />
            </div>
            <h3 className="text-lg font-bold text-[#3A3A2E] font-serif-natural">이웃 나눔 / 교환글 올리기</h3>
          </div>
          <button
            onClick={onClose}
            className="p-1 rounded-lg text-[#8D917A] hover:text-[#3A3A2E] hover:bg-[#E9EED9]"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        <form onSubmit={handleSubmit} className="mt-4 space-y-4">
          {/* Option: Quick Select from My Fridge */}
          {userIngredients.length > 0 && (
            <div className="bg-[#E9EED9]/60 p-3.5 rounded-2xl border border-[rgba(90,90,64,0.12)] space-y-1.5">
              <label className="block text-xs font-bold text-[#5A5A40] flex items-center gap-1">
                <Refrigerator className="w-3.5 h-3.5 text-[#5A5A40]" />
                <span>내 냉장고에서 식재료 선택하기 (빠른 불러오기)</span>
              </label>
              <select
                value={selectedFridgeItemId}
                onChange={(e) => handleSelectFridgeItem(e.target.value)}
                className="w-full text-xs p-2.5 border border-[rgba(90,90,64,0.15)] rounded-xl bg-white text-[#3A3A2E] font-medium"
              >
                <option value="">직접 입력하기</option>
                {userIngredients.map((ing) => (
                  <option key={ing.id} value={ing.id}>
                    {ing.name} ({ing.quantity} · {ing.storage})
                  </option>
                ))}
              </select>
            </div>
          )}

          {/* Share Type Selection */}
          <div className="grid grid-cols-2 gap-2">
            <button
              type="button"
              onClick={() => setType('free')}
              className={`py-2.5 px-3 rounded-2xl text-xs font-bold border transition-all flex items-center justify-center gap-1.5 cursor-pointer ${
                type === 'free'
                  ? 'bg-[#5A5A40] text-[#FAF9F6] border-[#5A5A40]'
                  : 'bg-white text-[#5A5A40] border-[rgba(90,90,64,0.15)] hover:bg-[#E9EED9]/50'
              }`}
            >
              <HeartHandshake className="w-4 h-4" />
              <span>무료 나눔 🎁</span>
            </button>

            <button
              type="button"
              onClick={() => setType('exchange')}
              className={`py-2.5 px-3 rounded-2xl text-xs font-bold border transition-all flex items-center justify-center gap-1.5 cursor-pointer ${
                type === 'exchange'
                  ? 'bg-[#5A5A40] text-[#FAF9F6] border-[#5A5A40]'
                  : 'bg-white text-[#5A5A40] border-[rgba(90,90,64,0.15)] hover:bg-[#E9EED9]/50'
              }`}
            >
              <ArrowRightLeft className="w-4 h-4" />
              <span>물꼬 교환 🔄</span>
            </button>
          </div>

          {/* Title */}
          <div>
            <label className="block text-xs font-semibold text-[#3A3A2E] mb-1">제목</label>
            <input
              type="text"
              required
              value={title}
              onChange={(e) => setTitle(e.target.value)}
              placeholder="예: 싱싱한 대파 반 단 무료 나눔합니다!"
              className="w-full px-3.5 py-2 text-sm border border-[rgba(90,90,64,0.15)] bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5A5A40]/20 text-[#3A3A2E]"
            />
          </div>

          {/* Ingredient & Category */}
          <div className="grid grid-cols-2 gap-3">
            <div>
              <label className="block text-xs font-semibold text-[#3A3A2E] mb-1">식재료명</label>
              <input
                type="text"
                required
                value={ingredientName}
                onChange={(e) => setIngredientName(e.target.value)}
                placeholder="예: 대파, 스팸, 양파"
                className="w-full px-3.5 py-2 text-sm border border-[rgba(90,90,64,0.15)] bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5A5A40]/20 text-[#3A3A2E]"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-[#3A3A2E] mb-1">카테고리</label>
              <select
                value={category}
                onChange={(e) => setCategory(e.target.value as CategoryType)}
                className="w-full px-3.5 py-2 text-sm border border-[rgba(90,90,64,0.15)] bg-white rounded-xl text-[#3A3A2E]"
              >
                <option value="채소/과일">채소/과일 🍎</option>
                <option value="정육/계란">정육/계란 🥩</option>
                <option value="가공식품/양념">가공식품/양념 🥫</option>
                <option value="베이커리/간식">베이커리/간식 🍞</option>
                <option value="음료/유제품">음료/유제품 🥛</option>
              </select>
            </div>
          </div>

          {/* Quantity & Storage */}
          <div className="grid grid-cols-2 gap-3">
            <div>
              <label className="block text-xs font-semibold text-[#3A3A2E] mb-1">나눔 수량</label>
              <input
                type="text"
                value={quantity}
                onChange={(e) => setQuantity(e.target.value)}
                placeholder="예: 5뿌리, 1캔"
                className="w-full px-3.5 py-2 text-sm border border-[rgba(90,90,64,0.15)] bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5A5A40]/20 text-[#3A3A2E]"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-[#3A3A2E] mb-1">보관 방식</label>
              <select
                value={storage}
                onChange={(e) => setStorage(e.target.value as StorageType)}
                className="w-full px-3.5 py-2 text-sm border border-[rgba(90,90,64,0.15)] bg-white rounded-xl text-[#3A3A2E]"
              >
                <option value="냉장">냉장 🧊</option>
                <option value="냉동">냉동 ❄️</option>
                <option value="상온">상온 🧺</option>
              </select>
            </div>
          </div>

          {/* Exchange Want Field */}
          {type === 'exchange' && (
            <div>
              <label className="block text-xs font-semibold text-[#5A5A40] mb-1">
                희망 교환 물품
              </label>
              <input
                type="text"
                value={exchangeWant}
                onChange={(e) => setExchangeWant(e.target.value)}
                placeholder="예: 양파 2개 또는 감자 2개와 교환해요"
                className="w-full px-3.5 py-2 text-sm border border-[rgba(90,90,64,0.15)] bg-[#E9EED9]/40 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5A5A40]/20 text-[#3A3A2E]"
              />
            </div>
          )}

          {/* Description */}
          <div>
            <label className="block text-xs font-semibold text-[#3A3A2E] mb-1">상세 설명</label>
            <textarea
              rows={3}
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              placeholder="나눔 장소, 보관 상태, 전달 가능한 시간 등을 적어주세요."
              className="w-full px-3.5 py-2 text-sm border border-[rgba(90,90,64,0.15)] bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5A5A40]/20 text-[#3A3A2E]"
            />
          </div>

          <button
            type="submit"
            className="w-full py-3 bg-[#5A5A40] hover:bg-[#484833] text-[#FAF9F6] font-bold text-sm rounded-2xl shadow-xs transition-all cursor-pointer flex items-center justify-center gap-1.5"
          >
            <span>이웃 나눔글 작성 완료</span>
          </button>
        </form>
      </div>
    </div>
  );
};
